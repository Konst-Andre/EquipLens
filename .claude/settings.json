{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash tools/env_check.sh)",
      "Bash(ENV_INJECT=1 bash tools/env_check.sh)",
      "Bash(bash /tmp/lens-governance/tools/claude-code/frame_check.sh .)",
      "Bash(python3 /tmp/lens-governance/kernel/Lens_validate.py --product .)",
      "Bash(python3 /tmp/lens-governance/kernel/Lens_validate.py --html *)",
      "Bash(python3 /tmp/lens-governance/tools/claude-code/hooks/ctx_watch.py marker *)"
    ]
  }
}
